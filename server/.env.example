# Study Book Backend Server Environment Configuration
# Copy this file to server/.env (or .env in project root)

PORT=5001
NODE_ENV=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=studybook-15297
# Optional: Path to Firebase Service Account JSON (if available)
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Supabase Storage Configuration (Backend Master / Service Role)
# IMPORTANT: Never commit or expose the service_role key to the frontend client!
SUPABASE_URL=https://hqrbmfjvsaltonpbivta.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=studybook-pdfs

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
